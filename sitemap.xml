---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign pages = site.pages | sort: "url" -%}
{%- for p in pages -%}
{%- if p.sitemap == false or p.url contains "404" or p.url contains ".xml" or p.url contains ".txt" or p.url contains ".css" -%}{%- continue -%}{%- endif %}
  <url>
    <loc>{{ p.url | absolute_url }}</loc>
    {%- if p.date %}
    <lastmod>{{ p.date | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>
